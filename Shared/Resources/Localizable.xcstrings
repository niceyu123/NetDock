      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP is a byte stream. Each RX record is a read chunk; sends may be split or combined."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP 是字节流；每条 RX 记录代表一次底层读取，可能拆分或合并发送内容。"
          }
        }
      }
    },

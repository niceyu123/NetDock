    "autoReconnectHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retry after 1, 2, 4, 8, 16, then 30 seconds when TCP fails or closes. Reset after connecting. Stop or background cancels retries; data and periodic sends are not replayed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP 连接失败或断开后按 1、2、4、8、16、30 秒间隔重试，成功后重置。手动停止或进入后台会取消重试；不会重发数据或恢复周期发送。"
          }
        }
      }
    },

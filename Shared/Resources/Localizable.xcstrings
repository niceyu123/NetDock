    "aboutDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NetDock is an open-source network tool for TCP and UDP client and server sessions, DNS lookup, and traffic logging."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NetDock 是一款开源网络工具，支持 TCP 和 UDP 客户端与服务端会话、DNS 查询和通信日志。"
          }
        }
      }
    },

    "error.activeSession" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session is running. Stop the connection or listener before changing network parameters."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话正在运行，请先停止连接或监听，再修改网络参数。"
          }
        }
      }
    },
    "error.addressInUse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port is in use. Stop the other listener or choose another port."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端口已被占用，请停止其他监听或更换端口。"
          }
        }
      }
    },
    "error.corruptStorage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session file is damaged and no valid backup is available. The original file is preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话文件损坏，且没有可用的备份。原文件已保留。"
          }
        }
      }
    },
    "error.datagramTooLarge" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP datagram too large. Send at most 65,507 bytes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP 数据报过大。单次发送最多 65,507 字节。"
          }
        }
      }
    },

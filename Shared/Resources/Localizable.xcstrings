    "udpConfigurationHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPv4 / IPv6 unicast only. Leave the local IP blank for any address and the client local port blank for automatic allocation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅支持 IPv4 / IPv6 单播。本地 IP 可留空；客户端本地端口可自动分配。"
          }
        }
      }
    },
    "udpHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP preserves datagrams. Local readiness does not mean the remote is online. TX means the OS accepted the send; delivery, order and reliability are not guaranteed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP 按数据报收发。本地就绪不表示对端在线；TX 仅表示系统已接受发送请求，不保证送达、顺序或可靠性。"
          }
        }
      }
    },

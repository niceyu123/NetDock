    "monitor.columnHelp.change" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compared with the previous usable snapshot: added, endpoint/state changed, disappeared, or unchanged. Additions and changes highlight for 3 seconds; disappeared rows remain for 5 seconds. Disappearance does not prove closure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与此前可用快照比较：新增、端点或状态变化、消失、无变化。新增和变化高亮 3 秒；消失保留 5 秒，仅表示未再观测到，不等于连接已关闭。"
          }
        }
      }
    },
    "monitor.columnHelp.localAddress" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The IP bound to or used by the local socket. 0.0.0.0 / :: usually indicates a wildcard rather than a network interface address. IPv6 may include a scope ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机 socket 绑定或使用的 IP。0.0.0.0 / :: 通常表示通配地址，不是实际网卡地址；IPv6 可带作用域编号。"
          }
        }
      }
    },
    "monitor.columnHelp.localPort" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local socket port, which may be assigned automatically. A listening port can help locate a service; no search results do not prove that a port is free."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机 socket 的端口，可能由系统自动分配。监听端口有助于定位服务；没有搜索结果不能证明端口空闲。"
          }
        }
      }
    },
    "monitor.columnHelp.pid" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owning process ID. An em dash means ownership is unavailable. The system can reuse PIDs, so an ID alone does not identify the same process over time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所属进程的编号。无法确认归属时显示“—”；系统会复用 PID，不能仅凭编号认定为同一进程。"
          }
        }
      }
    },
    "monitor.columnHelp.process" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The process that owns the socket, when readable. Unknown ownership is shown explicitly; apps or services are never inferred from port numbers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统可读的 socket 所属进程名。无法确认归属时显示“未知（权限限制）”，不会按端口猜测应用或服务。"
          }
        }
      }
    },
    "monitor.columnHelp.protocol" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The socket transport (TCP / UDP) and address family (IPv4 / IPv6). UDP has no TCP connection state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "socket 的传输协议（TCP / UDP）及地址族（IPv4 / IPv6）。UDP 不具备 TCP 连接状态。"
          }
        }
      }
    },
    "monitor.columnHelp.remoteAddress" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The peer IP recorded for the socket. Listening or unconnected sockets may show 0.0.0.0 / ::. For UDP, this is not a list of all datagram sources."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "socket 记录的对端 IP。监听或未连接的 socket 可能显示 0.0.0.0 / ::；UDP 此列不代表所有数据报来源。"
          }
        }
      }
    },
    "monitor.columnHelp.remotePort" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The peer port recorded for the socket. It is usually 0 for listening or unconnected sockets; this does not indicate a connection to a service on port 0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "socket 记录的对端端口。监听或未连接时通常为 0；不表示已经连接到端口 0 的服务。"
          }
        }
      }
    },
    "monitor.columnHelp.tcpState" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TCP state reported by the kernel, such as LISTEN, ESTABLISHED, or TIME_WAIT. UDP shows an em dash. State does not prove application data delivery."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内核报告的 TCP 状态，如 LISTEN（监听）、ESTABLISHED（已建立）、TIME_WAIT（等待旧报文过期）。UDP 显示“—”。状态不证明应用载荷已送达。"
          }
        }
      }
    },

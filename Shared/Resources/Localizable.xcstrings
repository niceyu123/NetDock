    "tlsHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use TLS 1.2 or later with system certificate-chain and hostname validation. An explicit name is used for both SNI and certificate verification. TCP Client only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 TLS 1.2 或更高版本。系统验证证书链和服务器名称；指定名称同时用于 SNI 和证书验证。仅支持 TCP Client。"
          }
        }
      }
    },

    "monitor.scopeLimit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows snapshots permitted by public system APIs, without guaranteed system-wide coverage. Unresolved ownership is Unknown (permission restricted). No result does not prove a port is free. TIME_WAIT may appear in PCB snapshots; visibility and attribution are not guaranteed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅显示系统公开接口允许读取的快照，不保证全系统覆盖。无法确认进程归属时显示“未知（权限限制）”。无结果不代表端口可用；TIME_WAIT 可能出现在 PCB 快照中，但不保证可见或可归属。"
          }
        }
      }
    },
